# =================================================================
# VERDICT STUDIO - BACKEND ENVIRONMENT VARIABLES
# =================================================================
# For Render / Cloud Deployments: Configure in your Render Dashboard.
# For Local Development: Copy this file to .env in the backend directory.

# -----------------------------------------------------------------
# SERVER & NETWORK CONFIGURATION
# -----------------------------------------------------------------
# Server binding port (Render assigns this automatically via $PORT)
PORT=8000
HOST=0.0.0.0

# Allowed CORS origins (comma-separated or '*' for all origins including *.vercel.app and *.pages.dev)
CORS_ORIGINS=*

# -----------------------------------------------------------------
# OPTIONAL SERVER-SIDE API KEYS (BYOK Fallback)
# -----------------------------------------------------------------
# Users can provide their own keys in the UI (Client-Side BYOK).
# These keys serve as optional server-level fallbacks if desired:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
