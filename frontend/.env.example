# =================================================================
# VERDICT STUDIO - FRONTEND ENVIRONMENT VARIABLES
# =================================================================
# For Cloudflare Pages: Configure these under Settings > Environment Variables.
# For Local Development: Copy this file to .env.local

# -----------------------------------------------------------------
# 🌐 BACKEND API & WEBSOCKET ENDPOINTS
# -----------------------------------------------------------------
# Production Render URL (replace 'verdict-studio-backend' with your Render app name)
NEXT_PUBLIC_API_URL=https://verdict-studio-backend.onrender.com
NEXT_PUBLIC_WS_URL=wss://verdict-studio-backend.onrender.com

# Local Development Defaults:
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_WS_URL=ws://localhost:8000
